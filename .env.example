# ==================================================
# GAROA RP — Loja Virtual
# Copie este arquivo para .env na raiz OU para
# backend/.env e frontend/.env conforme o ambiente.
# NUNCA commite arquivos .env com credenciais reais.
# ==================================================

# --- Aplicação ---
# Local:
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3333
PORT=3333
# VPS (HTTPS público, atrás do Nginx/Cloudflare):
# NODE_ENV=production
# APP_URL=https://loja.garoarp.com
# API_URL=https://loja.garoarp.com/api
# ALLOWED_ORIGINS=https://loja.garoarp.com
# FRONTEND_URL=https://loja.garoarp.com
# PAYMENT_DEV_MODE=false

# --- Banco de dados ---
# Desenvolvimento local (SQLite, sem Docker):
DATABASE_URL=file:./dev.db
# Produção (PostgreSQL no Docker/VPS) — altere o provider em prisma/schema.prisma para postgresql:
# DATABASE_URL=postgresql://garoa:garoa_secret@localhost:5432/garoa_store?schema=public

# --- Autenticação administrativa ---
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-minimo-32-caracteres
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@garoarp.com
ADMIN_PASSWORD=TroqueEstaSenha123!

# --- CORS ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Uploads ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=8

# --- Gateway de pagamento (Mercado Pago) ---
# SOMENTE no servidor. Nunca coloque estas variáveis no frontend/Vite.
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Webhook a cadastrar no MP: {API_URL}/webhooks/payment
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# true apenas em desenvolvimento local para testar o fluxo
# de webhook/entrega sem credenciais do gateway.
PAYMENT_DEV_MODE=true

# --- Integração FiveM (servidor da cidade) ---
# FIVEM_API_URL só se a cidade receber POST. O fluxo padrão é o resource
# ng-loja consultar GET /fivem/deliveries/pending com esta API key.
FIVEM_API_URL=
FIVEM_API_KEY=
FIVEM_TIMEOUT_MS=8000

# --- Discord (cargo VIP após pagamento) ---
# Bot com permissão Gerenciar Cargos, cargo do bot acima dos cargos VIP.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_SELECT=
DISCORD_ROLE_PRIME=
DISCORD_ROLE_PRESTIGE=
DISCORD_ROLE_ELITE=
DISCORD_ROLE_IMPERIAL=
DISCORD_ROLE_SUPREME=

# --- Rate limit ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3333
VITE_STORE_NAME=Garoa RP
