# Copie para backend/.env NA VPS.
# Tokens: cole os mesmos do seu PC (backend/.env local).
# Nunca commite este arquivo depois de preencher.

NODE_ENV=production
PORT=3333

APP_URL=https://novagaroa.com.br
API_URL=https://novagaroa.com.br/api
FRONTEND_URL=https://novagaroa.com.br
ALLOWED_ORIGINS=https://novagaroa.com.br,https://www.novagaroa.com.br

# SQLite no disco da VPS (mais simples no primeiro deploy)
DATABASE_URL=file:./dev.db

JWT_SECRET=troque-por-uma-string-longa-aleatoria-minimo-32-caracteres
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@novagaroa.com.br
ADMIN_PASSWORD=troque-esta-senha-agora

UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=8

PAYMENT_PROVIDER=mercadopago
PAYMENT_DEV_MODE=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

FIVEM_API_URL=http://104.234.63.151:30120/ng-loja
FIVEM_API_KEY=
FIVEM_TIMEOUT_MS=8000

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_SELECT=
DISCORD_ROLE_PRIME=
DISCORD_ROLE_PRESTIGE=
DISCORD_ROLE_ELITE=
DISCORD_ROLE_IMPERIAL=
DISCORD_ROLE_SUPREME=

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
